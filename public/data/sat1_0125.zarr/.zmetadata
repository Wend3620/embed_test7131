{
    "metadata": {
        ".zattrs": {
            "channels": "all",
            "description": "SAT1 spectral radiance statistics (mean and standard deviation) for all 63 channels for 0125",
            "grid_resolution_deg": 1.0,
            "n_granules": 432,
            "pass_direction": "both",
            "percentile_range": "1st to 99th percentile used for statistics",
            "quality_flag_values": "0",
            "radiance_correction_applied": "yes",
            "source": "Processed from PREFIRE-SAT1 1B-RAD R02 granules",
            "std_definition": "population standard deviation (ddof=0); NaN where fewer than 2 observations",
            "time": "0125",
            "valid_range": "0.0 to 25.0 W m-2 sr-1 micron-1",
            "wavelength_units": "micron"
        },
        ".zgroup": {
            "zarr_format": 2
        },
        "lat/.zarray": {
            "chunks": [
                180
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f8",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                180
            ],
            "zarr_format": 2
        },
        "lat/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lat"
            ],
            "long_name": "Latitude of grid-cell centre",
            "units": "degrees_north"
        },
        "lon/.zarray": {
            "chunks": [
                360
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f8",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                360
            ],
            "zarr_format": 2
        },
        "lon/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lon"
            ],
            "long_name": "Longitude of grid-cell centre",
            "units": "degrees_east"
        },
        "mean_sr/.zarray": {
            "chunks": [
                45,
                90,
                32
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                180,
                360,
                63
            ],
            "zarr_format": 2
        },
        "mean_sr/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lat",
                "lon",
                "spectral"
            ],
            "coordinates": "wavelength",
            "long_name": "Mean Spectral Radiance",
            "short_name": "Mean SR",
            "units": "W m-2 sr-1 micron-1"
        },
        "spectral/.zarray": {
            "chunks": [
                63
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<i4",
            "fill_value": null,
            "filters": null,
            "order": "C",
            "shape": [
                63
            ],
            "zarr_format": 2
        },
        "spectral/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "spectral"
            ],
            "long_name": "Channel index (0-based position in the 1B-RAD spectral dimension)"
        },
        "std_sr/.zarray": {
            "chunks": [
                45,
                90,
                32
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                180,
                360,
                63
            ],
            "zarr_format": 2
        },
        "std_sr/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lat",
                "lon",
                "spectral"
            ],
            "coordinates": "wavelength",
            "long_name": "Standard Deviation of Spectral Radiance",
            "short_name": "Std SR",
            "units": "W m-2 sr-1 micron-1"
        },
        "wavelength/.zarray": {
            "chunks": [
                63
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f8",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                63
            ],
            "zarr_format": 2
        },
        "wavelength/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "spectral"
            ],
            "long_name": "Channel centre wavelength (mean over xtrack and granules)",
            "units": "micron"
        }
    },
    "zarr_consolidated_format": 1
}